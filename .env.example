# Trybe Backend Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DB_NAME=trybe_db
DB_USER=trybe_user
DB_PASSWORD=your-secure-password-here
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://trybe_user:your-secure-password-here@postgres:5432/trybe_db
DB_ECHO=false

# Redis Configuration
REDIS_PASSWORD=your-redis-password-here
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:your-redis-password-here@redis:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-jwt-key-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
STRIPE_API_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email Configuration (SendGrid/SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@trybe.app
FROM_NAME=Trybe Platform

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Application Settings
ENVIRONMENT=development
DEBUG=true
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sentry Error Tracking
SENTRY_DSN=https://...@sentry.io/...

# PgAdmin (Optional)
PGADMIN_EMAIL=admin@trybe.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Redis Commander (Optional)
REDIS_COMMANDER_PORT=8081

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Session
SESSION_EXPIRE_HOURS=24

# Platform Settings
PLATFORM_FEE_PERCENTAGE=8.0
STRIPE_FEE_PERCENTAGE=2.9
STRIPE_FEE_FIXED=0.30
